  lookupflag 0;
  markClass [\stavrosAbove ] <anchor 0 0> @stavros;
  markClass [\diesis2Tertiary \diesis4Tertiary \diesis6Tertiary \diesis8Tertiary ] <anchor 0 0> @diesisTertiary;
